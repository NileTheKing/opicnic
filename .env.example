DOMAIN=opicnic.xyz
DB_USERNAME=opicnic
DB_PASSWORD=your_strong_password
GROQ_API_KEY=your_groq_api_key
# LLM 공급자(채점·태깅·코칭): groq(기본) 또는 gemini. STT는 항상 Groq
LLM_PROVIDER=groq
GEMINI_API_KEY=
GRAFANA_PASSWORD=your_grafana_password
DISCORD_WEBHOOK_URL=

# Cloudflare R2 — 오디오 저장 (docs/adr/0001-async-r2.md). 버킷·CORS·라이프사이클은 scripts/r2/setup.sh
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opicnic-audio
