server {
    listen 80;
    server_name ${DOMAIN};

    # 오디오는 브라우저가 R2에 직접 올리므로(ADR-0001) 서버로 오는 요청 본문은 JSON뿐이다.
    # 1M이면 충분 — 옛 64M(모의고사 15문항 x 4MB)은 동기 업로드 경로와 함께 2026-09-21 제거.
    client_max_body_size 1M;

    # SEC-07: actuator(헬스체크/메트릭)는 외부에 열 필요 없다 — 내부 Prometheus는
    # 이 nginx를 거치지 않고 Docker network로 opicnic_app:8080에 직접 scrape한다.
    location /actuator/ {
        deny all;
        return 404;
    }

    # 앱 주소를 요청 때마다 Docker 내부 DNS(127.0.0.11)로 다시 찾는다. proxy_pass에 이름을 바로 쓰면 nginx가
    # 켜질 때 IP를 한 번만 찾아 계속 쓰는데, 앱이 재생성되며 IP가 바뀌면 502가 난다
    # (2026-10-08: compose pull로 mysql이 먼저 재생성돼 옛 앱 IP를 가져감). valid=10s는 DNS 응답 캐시 시간
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $app_upstream http://opicnic_app:8080;

    location / {
        proxy_pass $app_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

}
